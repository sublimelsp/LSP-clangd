[
  {
    "id": "tools",
    "children": [
      {
        "id": "lsp",
        "children": [
          {
            "caption": "clangd: View Syntax Tree",
            "command": "lsp_clangd_view_syntax_tree",
          },
          {
            "caption": "clangd: Memory Usage",
            "command": "lsp_clangd_memory_usage",
          },
        ]
      }
    ]
  },
  {
    "id": "preferences",
    "children": [
      {
        "id": "package-settings",
        "children": [
          {
            "id": "lsp-settings",
            "children": [
              {
                "id": "lsp-servers",
                "children": [
                  {
                    "caption": "LSP-clangd",
                    "command": "edit_settings",
                    "args": {
                      "base_file": "${packages}/LSP-clangd/LSP-clangd.sublime-settings",
                      "default": "// Settings in here override those in \"LSP-clangd/LSP-clangd.sublime-settings\"\n\n{\n\t$0\n}\n",
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
